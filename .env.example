# Pantaker environment
# Copy to .env and fill in real values. Never commit .env.
# Secrets (anything not prefixed NEXT_PUBLIC_) stay server-only.

# Database -------------------------------------------------------------------
# Session pooler URL used by the app.
DATABASE_URL=postgresql://user:password@host:5432/pantaker
# Direct host used by Prisma CLI tooling (generate/studio).
DIRECT_URL=postgresql://user:password@host:5432/pantaker

# Auth -----------------------------------------------------------------------
AUTH_SECRET=replace-with-a-long-random-secret
# Dedicated HMAC secret for pickup codes. Must differ from AUTH_SECRET.
# Required in production; local development falls back to AUTH_SECRET.
PICKUP_CODE_SECRET=12345
AUTH_URL=http://localhost:3000
# Optional preview sign-in bypass. Never enable in production.
NEXT_PUBLIC_PREVIEW_AUTH=

# Site -----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Email (SMTP) ---------------------------------------------------------------
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=Pantaker <hello@example.com>
# Or a single connection URL instead of the fields above:
# EMAIL_SERVER=smtp://user:password@smtp.example.com:587

# Images ---------------------------------------------------------------------
# r2 in production; local is development-only.
PANTAKER_IMAGE_MODE=r2
LOCAL_UPLOAD_DIR=.local-uploads

CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=https://<public-bucket-domain>
# Optional, only for legacy Cloudflare Images IDs.
NEXT_PUBLIC_CLOUDFLARE_IMAGES_DELIVERY_HASH=

# Payments (Bachs) -----------------------------------------------------------
# Server-only API key. Use the sandbox key locally and the live key in production.
BACHS_SECRET_KEY=
# Signing secret for webhook verification.
BACHS_WEBHOOK_SECRET=
# Optional override. Defaults to sandbox-api.bachs.io / api.bachs.io by key.
BACHS_API_BASE_URL=

# Scheduled jobs -------------------------------------------------------------
# Bearer token for /api/cron/orders. The scheduler must send it.
CRON_SECRET=replace-with-a-random-cron-secret
