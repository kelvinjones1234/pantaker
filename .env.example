# Public (Supabase browser key — safe to expose)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical site URL (dev + prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — NEVER prefix with NEXT_PUBLIC_ / never commit real values
SUPABASE_SERVICE_ROLE_KEY=

# Prisma (direct Postgres connection — server-only, bypasses RLS).
# Use the Supabase pooler for DATABASE_URL and the direct host for DIRECT_URL.
# Get both from Supabase Dashboard → Project Settings → Database.
DATABASE_URL=
DIRECT_URL=
