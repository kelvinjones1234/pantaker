# Pantaker environment template. Copy to .env and fill in real values.
# Never commit real credentials.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/pantaker
DIRECT_URL=postgresql://user:password@host:5432/pantaker

# NextAuth / email delivery
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=mailer@example.com
EMAIL_SERVER_PASSWORD=replace-me
EMAIL_FROM="Pantaker <hello@example.com>"

# Cloudflare R2 image storage
PANTAKER_IMAGE_MODE=r2
CLOUDFLARE_R2_BUCKET=pantaker
CLOUDFLARE_R2_ACCESS_KEY=replace-with-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=replace-with-r2-secret-key
CLOUDFLARE_R2_BUCKET_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=https://your-public-r2-domain.r2.dev

# Optional: legacy Cloudflare Images IDs only, for the migration script.
# NEXT_PUBLIC_CLOUDFLARE_IMAGES_DELIVERY_HASH=

# Development-only local image storage. Never use in production.
# PANTAKER_IMAGE_MODE=local
# LOCAL_UPLOAD_DIR=.local-uploads
# LOCAL_UPLOAD_SECRET=change-me-for-local-dev
