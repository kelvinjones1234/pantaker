# Public (Supabase browser key — safe to expose)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical site URL (dev + prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Preview auth: allow viewing/using the sell form without signing in.
# Local development always allows this; set to "true" to also allow it in a
# production build (submissions still validate but are not saved).
NEXT_PUBLIC_PREVIEW_AUTH=false

# Server-only — NEVER prefix with NEXT_PUBLIC_ / never commit real values
SUPABASE_SERVICE_ROLE_KEY=

# Prisma (direct Postgres connection — server-only, bypasses RLS).
# Get both from Supabase Dashboard → Project Settings → Database.
# DATABASE_URL: prefer the "Session pooler" string (port 5432). The pg driver
#   uses prepared statements, which the transaction pooler (6543) does not support.
# DIRECT_URL: the direct host, used by the Prisma CLI for schema changes.
DATABASE_URL=
DIRECT_URL=

# Cloudflare Images (listing photos). Server-only secrets, never prefix with NEXT_PUBLIC_:
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=
# Account delivery hash + variant name are public (used to build image URLs).
NEXT_PUBLIC_CLOUDFLARE_IMAGES_DELIVERY_HASH=
NEXT_PUBLIC_CLOUDFLARE_IMAGES_VARIANT=public
