// Pantaker data model.
//
// SQL migrations in supabase/migrations are the schema source of truth. Prisma
// is introspected from those tables and owns all application reads/writes.
// Auth identity lives in public.users; Supabase Auth/RLS/Data API are no longer
// used by the application.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  super_admin
  moderator

  @@map("admin_role")
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @unique
  email_verified  DateTime?  @db.Timestamptz(6)
  password_hash   String?
  name            String?
  image           String?
  admin_role      AdminRole?
  session_version Int        @default(1)
  created_at      DateTime   @default(now()) @db.Timestamptz(6)
  updated_at      DateTime   @default(now()) @db.Timestamptz(6)

  profile               Profile?
  account_restriction   AccountRestriction?
  email_change_requests EmailChangeRequest[]
  listings              Listing[]
  buyer_inquiries       Inquiry[]             @relation("InquiryBuyer")
  seller_inquiries      Inquiry[]             @relation("InquirySeller")
  reports_made          Report[]              @relation("ReportReporter")
  reports_received      Report[]              @relation("ReportReportedUser")
  reports_resolved      Report[]              @relation("ReportResolvedBy")
  upload_requests       UploadRequest[]
  payment_account       SellerPaymentAccount?
  buyer_orders          Order[]               @relation("OrderBuyer")
  seller_orders         Order[]               @relation("OrderSeller")
  order_events          OrderEvent[]
  refunds_requested     OrderRefund[]
  payouts               SellerPayout[]

  @@map("users")
}

model Profile {
  id                    String    @id @db.Uuid
  display_name          String?
  username              String?
  avatar_path           String?
  city                  String?
  area                  String?
  account_type          String    @default("individual")
  bio                   String?
  phone                 String?
  phone_is_whatsapp     Boolean   @default(false)
  instagram_handle      String?
  x_handle              String?
  facebook_handle       String?
  tiktok_handle         String?
  default_area          String?
  default_pickup_notes  String?
  deletion_requested_at DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model LoginOtp {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String
  code_hash     String
  password_hash String?
  expires_at    DateTime  @db.Timestamptz(6)
  consumed_at   DateTime? @db.Timestamptz(6)
  attempts      Int       @default(0)
  ip            String?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([email, created_at(sort: Desc)])
  @@index([expires_at])
  @@index([ip, created_at(sort: Desc)])
  @@map("login_otps")
}

model EmailChangeRequest {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  new_email   String
  token_hash  String    @unique
  expires_at  DateTime  @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)])
  @@map("email_change_requests")
}

model AccountRestriction {
  user_id    String    @id @db.Uuid
  status     String
  reason     String
  starts_at  DateTime  @default(now()) @db.Timestamptz(6)
  ends_at    DateTime? @db.Timestamptz(6)
  created_by String    @db.Uuid
  updated_by String    @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([status, updated_at(sort: Desc)])
  @@map("account_restrictions")
}

model AdminAuditEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id    String?  @db.Uuid
  action      String
  target_type String
  target_id   String
  reason      String?
  before      Json?
  after       Json?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([actor_id, created_at(sort: Desc)])
  @@index([created_at(sort: Desc)])
  @@index([target_type, target_id, created_at(sort: Desc)])
  @@map("admin_audit_events")
}

model Block {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blocker_id String   @db.Uuid
  blocked_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([blocker_id, blocked_id])
  @@index([blocked_id])
  @@map("blocks")
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  parent_id   String?  @db.Uuid
  icon_key    String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  parent   Category?  @relation("CategoryParent", fields: [parent_id], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryParent")
  listings Listing[]

  @@index([is_active, sort_order, name])
  @@index([parent_id])
  @@map("categories")
}

model CategoryAuditEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id String?  @db.Uuid
  actor_id    String?  @db.Uuid
  action      String
  before      Json?
  after       Json?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([category_id, created_at(sort: Desc)])
  @@index([created_at(sort: Desc)])
  @@map("category_audit_events")
}

model Inquiry {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id          String    @db.Uuid
  buyer_id            String    @db.Uuid
  seller_id           String    @db.Uuid
  message             String    @default("")
  status              String    @default("open")
  last_message_at     DateTime  @default(now()) @db.Timestamptz(6)
  buyer_last_read_at  DateTime? @db.Timestamptz(6)
  seller_last_read_at DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)

  listing Listing @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  buyer   User    @relation("InquiryBuyer", fields: [buyer_id], references: [id], onDelete: Cascade)
  seller  User    @relation("InquirySeller", fields: [seller_id], references: [id], onDelete: Cascade)

  messages Message[]
  reports  Report[]
  sales    Sale[]

  @@index([buyer_id, last_message_at(sort: Desc)])
  @@index([listing_id])
  @@index([seller_id, last_message_at(sort: Desc)])
  @@map("inquiries")
}

model ListingImage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id   String   @db.Uuid
  storage_path String
  alt_text     String?
  sort_order   Int      @default(0)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  listing Listing @relation(fields: [listing_id], references: [id], onDelete: Cascade)

  @@index([listing_id, sort_order])
  @@index([storage_path])
  @@map("listing_images")
}

model Listing {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seller_id     String                   @db.Uuid
  category_id   String?                  @db.Uuid
  title         String
  slug          String                   @unique
  description   String                   @default("")
  condition     String                   @default("used")
  item_status   String                   @default("draft")
  pricing_type  String                   @default("fixed")
  price         Int?
  negotiable    Boolean                  @default(false)
  quantity      Decimal?                 @default(1) @db.Decimal(12, 3)
  quantity_unit String?                  @default("item")
  city          String                   @default("Abuja")
  area          String?
  pickup_notes  String?
  published_at  DateTime?                @db.Timestamptz(6)
  expires_at    DateTime?                @db.Timestamptz(6)
  created_at    DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                 @default(now()) @db.Timestamptz(6)
  search_vector Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, ((((COALESCE(title, ''::text) || ' '::text) || COALESCE(description, ''::text)) || ' '::text) || COALESCE(area, ''::text)))"))

  seller    User           @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  category  Category?      @relation(fields: [category_id], references: [id])
  images    ListingImage[]
  inquiries Inquiry[]
  reports   Report[]
  sale      Sale?
  orders    Order[]

  @@index([category_id, item_status])
  @@index([item_status, published_at(sort: Desc)], where: raw("(item_status = 'published'::text)"))
  @@index([area, published_at(sort: Desc)], where: raw("(item_status = 'published'::text)"))
  @@index([search_vector], type: Gin)
  @@index([seller_id, item_status, updated_at(sort: Desc)])
  @@map("listings")
}

model Message {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inquiry_id String   @db.Uuid
  sender_id  String   @db.Uuid
  body       String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  inquiry Inquiry @relation(fields: [inquiry_id], references: [id], onDelete: Cascade)

  @@index([inquiry_id, created_at])
  @@map("messages")
}

model NotificationPreference {
  user_id         String   @id @db.Uuid
  messages        Boolean  @default(true)
  sale_updates    Boolean  @default(true)
  listing_updates Boolean  @default(true)
  order_updates   Boolean  @default(true)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@map("notification_preferences")
}

model Notification {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  type            String
  title           String
  body            String?
  href            String
  listing_id      String?   @db.Uuid
  conversation_id String?   @db.Uuid
  sale_id         String?   @db.Uuid
  actor_id        String?   @db.Uuid
  read_at         DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  dedupe_key      String?

  @@unique([user_id, dedupe_key], where: raw("(dedupe_key IS NOT NULL)"))
  @@index([user_id, created_at(sort: Desc)])
  @@index([user_id], where: raw("(read_at IS NULL)"))
  @@map("notifications")
}

model Report {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporter_id      String    @db.Uuid
  listing_id       String?   @db.Uuid
  reported_user_id String?   @db.Uuid
  conversation_id  String?   @db.Uuid
  reason           String
  details          String?
  status           String    @default("open")
  resolution_note  String?
  resolved_by      String?   @db.Uuid
  resolved_at      DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)

  reporter      User     @relation("ReportReporter", fields: [reporter_id], references: [id], onDelete: Cascade)
  reported_user User?    @relation("ReportReportedUser", fields: [reported_user_id], references: [id])
  resolved_user User?    @relation("ReportResolvedBy", fields: [resolved_by], references: [id])
  listing       Listing? @relation(fields: [listing_id], references: [id])
  conversation  Inquiry? @relation(fields: [conversation_id], references: [id])

  @@index([listing_id])
  @@index([reporter_id, created_at(sort: Desc)])
  @@index([status, created_at(sort: Desc)])
  @@map("reports")
}

model Sale {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id        String    @unique(map: "sales_one_active_per_listing", where: raw("(status = ANY (ARRAY['awaiting_confirmation'::text, 'reserved'::text, 'collection_arranged'::text]))")) @db.Uuid
  seller_id         String    @db.Uuid
  buyer_id          String?   @db.Uuid
  buyer_label       String?
  source_inquiry_id String?   @db.Uuid
  agreed_price      Int?
  status            String    @default("awaiting_confirmation")
  collection_notes  String?
  completed_at      DateTime? @db.Timestamptz(6)
  cancelled_at      DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)

  listing        Listing  @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  source_inquiry Inquiry? @relation(fields: [source_inquiry_id], references: [id])

  @@index([listing_id])
  @@index([seller_id, created_at(sort: Desc)])
  @@map("sales")
}

model SellerPaymentAccount {
  user_id                String    @id @db.Uuid
  bachs_account_id       String    @unique
  onboarding_status      String    @default("pending")
  transfers_status       String    @default("unrequested")
  payouts_status         String    @default("unrequested")
  destination_usable     Boolean   @default(false)
  requirements           Json?
  available_balance_kobo BigInt?
  pending_balance_kobo   BigInt?
  balance_synced_at      DateTime? @db.Timestamptz(6)
  last_error             String?
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("seller_payment_accounts")
}

model Order {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_number         String    @unique
  listing_id           String?   @db.Uuid
  seller_id            String?   @db.Uuid
  buyer_id             String?   @db.Uuid
  buyer_name           String?
  buyer_email          String?
  seller_name          String?
  item_title           String
  item_amount_kobo     BigInt
  commission_kobo      BigInt
  seller_share_kobo    BigInt
  currency             String    @default("NGN")
  status               String    @default("pending_payment")
  pickup_code_hash     String?
  pickup_code_attempts Int       @default(0)
  expires_at           DateTime? @db.Timestamptz(6)
  paid_at              DateTime? @db.Timestamptz(6)
  ready_at             DateTime? @db.Timestamptz(6)
  handover_at          DateTime? @db.Timestamptz(6)
  buyer_confirmed_at   DateTime? @db.Timestamptz(6)
  release_due_at       DateTime? @db.Timestamptz(6)
  released_at          DateTime? @db.Timestamptz(6)
  cancelled_at         DateTime? @db.Timestamptz(6)
  refunded_at          DateTime? @db.Timestamptz(6)
  release_attempts     Int       @default(0)
  last_release_error   String?
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @db.Timestamptz(6)

  listing   Listing?        @relation(fields: [listing_id], references: [id], onDelete: SetNull)
  seller    User?           @relation("OrderSeller", fields: [seller_id], references: [id], onDelete: SetNull)
  buyer     User?           @relation("OrderBuyer", fields: [buyer_id], references: [id], onDelete: SetNull)
  payment   OrderPayment?
  events    OrderEvent[]
  transfers OrderTransfer[]
  refunds   OrderRefund[]
  disputes  OrderDispute[]

  @@index([buyer_id, created_at(sort: Desc)])
  @@index([seller_id, created_at(sort: Desc)])
  @@index([status, release_due_at])
  @@index([listing_id])
  @@index([refunded_at], where: raw("(refunded_at IS NOT NULL AND released_at IS NOT NULL)"))
  @@map("orders")
}

model OrderPayment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id          String    @unique @db.Uuid
  provider          String    @default("bachs")
  checkout_id       String?   @unique
  charge_id         String?   @unique
  checkout_url      String?
  reference         String    @unique
  idempotency_key   String    @unique
  amount_kobo       BigInt
  currency          String    @default("NGN")
  status            String    @default("pending")
  provider_fee_kobo BigInt?
  failure_reason    String?
  paid_at           DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("order_payments")
}

model OrderEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String   @db.Uuid
  actor_id   String?  @db.Uuid
  type       String
  message    String?
  metadata   Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([order_id, created_at])
  @@map("order_events")
}

model OrderTransfer {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id          String   @db.Uuid
  type              String
  bachs_transfer_id String?  @unique
  idempotency_key   String   @unique
  amount_kobo       BigInt
  currency          String   @default("NGN")
  status            String   @default("pending")
  error             String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id, created_at(sort: Desc)])
  @@index([updated_at], where: raw("(status = 'pending'::text)"))
  @@map("order_transfers")
}

model OrderRefund {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id        String   @db.Uuid
  bachs_refund_id String?  @unique
  idempotency_key String   @unique
  amount_kobo     BigInt
  status          String   @default("pending")
  reason          String?
  requested_by    String?  @db.Uuid
  failure_reason  String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  order     Order @relation(fields: [order_id], references: [id], onDelete: Cascade)
  requester User? @relation(fields: [requested_by], references: [id], onDelete: SetNull)

  @@index([order_id, created_at(sort: Desc)])
  @@map("order_refunds")
}

model OrderDispute {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id         String    @db.Uuid
  bachs_dispute_id String    @unique
  status           String    @default("open")
  amount_kobo      BigInt?
  evidence_due_at  DateTime? @db.Timestamptz(6)
  last_event_at    DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id, created_at(sort: Desc)])
  @@map("order_disputes")
}

model BachsWebhookEvent {
  id               String    @id
  type             String
  account_id       String?
  payload          Json
  event_created_at DateTime? @db.Timestamptz(6)
  received_at      DateTime  @default(now()) @db.Timestamptz(6)
  processed_at     DateTime? @db.Timestamptz(6)
  error            String?
  attempts         Int       @default(1)

  @@index([received_at(sort: Desc)])
  @@map("bachs_webhook_events")
}

model SellerPayout {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seller_id          String?  @db.Uuid
  bachs_payout_id    String?  @unique
  destination_id     String?
  reference          String   @unique
  idempotency_key    String   @unique
  amount_kobo        BigInt
  fee_kobo           BigInt?
  total_debited_kobo BigInt?
  currency           String   @default("NGN")
  status             String   @default("pending")
  failure_reason     String?
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)

  seller User? @relation(fields: [seller_id], references: [id], onDelete: SetNull)

  @@index([seller_id, created_at(sort: Desc)])
  @@map("seller_payouts")
}

model UploadRequest {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)])
  @@map("upload_requests")
}
